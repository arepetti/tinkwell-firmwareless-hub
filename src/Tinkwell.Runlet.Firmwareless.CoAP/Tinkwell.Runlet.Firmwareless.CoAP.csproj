    <Protobuf Include="..\..\proto\measures.proto" GrpcServices="Client" Link="Proto\measures.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\app\libs\Tinkwell.Coap\Tinkwell.Coap.csproj" />
    <ProjectReference Include="..\..\..\..\..\app\libs\Tinkwell.Coap.Server\Tinkwell.Coap.Server.csproj" />
    <ProjectReference Include="..\..\..\..\..\app\libs\Tinkwell.Telemetry\Tinkwell.Telemetry.csproj" />
  </ItemGroup>

